{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "lib": ["ES2022"],
        "typeRoots": ["./node_modules/@types", "./node_modules/@figma"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/plugin/**/*.ts", "src/shared/**/*.ts"]
}
